// design_review.typ · Taif / Palm House V6 · full design review against the owner's requirements (docs/REQUIREMENTS.md), Saudi regulation
// and practice, and global best practice · review only: no design file is changed · compile THIS file:
//   typst compile --root taif_house taif_house/docs/review/design_review.typ taif_house/output/Design_Review_V6.pdf
// Every area, width, distance and glazing figure comes from the project files through the presentation's own helpers (data/*.csv, the design
// files, the studies, 3d/params.yaml for the window heights); nothing is typed by hand. Coordinates are the CSV frame (x east, y south).
#import "@preview/cetz:0.4.2"
#import "/presentation.typ": gf-rooms, ff-rooms, clear-poly, gf-walls, ff-walls, area, bbox, gf-doors, gf-windows, ff-doors, ff-windows, n2, dist, on-seg
#import "/base.typ": land, env, drv, lane, edges, seg-dist
#import "/design_gf.typ": outline-gf, outline-csv-gf, env-gap, m-gap, shift
#import "/studies/sections.typ" as sec
#import "/studies/structure.typ": st
#let P = yaml("/3d/params.yaml")
#let CH = yaml("/3d/character.yaml")
#let pit-box = CH.sunken.box
#let pit-area = (pit-box.at(2) - pit-box.at(0)) * (pit-box.at(3) - pit-box.at(1))

// ================= look =================
#set page(paper: "a4", margin: (x: 16mm, y: 16mm), numbering: "1 / 1", number-align: right,
  header: context { if counter(page).get().first() > 1 [#text(7.5pt, fill: luma(110))[Taif / Palm House · design review V6 · 30 Oct 2026 · review only, no design file changed] #h(1fr) #text(7.5pt, fill: luma(110))[docs/review/design_review.typ]] })
#set text(font: ("Segoe UI", "Arial"), size: 8.6pt, lang: "en")
#set par(justify: false, leading: 0.5em, spacing: 0.7em)
#set heading(numbering: "1.1")
#show heading.where(level: 1): it => { pagebreak(weak: true); block(above: 6pt, below: 8pt, text(15pt, weight: "bold", fill: rgb("#2f6b4f"), it)) }
#show heading.where(level: 2): it => block(above: 10pt, below: 5pt, text(11pt, weight: "bold", fill: rgb("#2f6b4f"), it))
#show heading.where(level: 3): it => block(above: 8pt, below: 4pt, text(9.5pt, weight: "bold", fill: rgb("#3d4a45"), it))
#let green = rgb("#2f6b4f")
#let ink = rgb("#3d4a45")
#let red = rgb("#b5452f")
#let sevc = (critical: rgb("#b5452f"), major: rgb("#c25b00"), minor: rgb("#8a7a2a"), suggestion: rgb("#4a6d8a"), strength: rgb("#2f6b4f"))
#let sev(s) = box(fill: sevc.at(s), inset: (x: 3pt, y: 1.5pt), radius: 2pt, text(7pt, weight: "bold", fill: white, upper(s)))
#let ar(body) = block(width: 100%, fill: rgb("#f3efe6"), inset: 7pt, radius: 2pt, text(9.5pt, lang: "ar", dir: rtl, body))
#let note(body) = block(width: 100%, fill: rgb("#eef2ea"), inset: 7pt, radius: 2pt, body)
#let warnbox(body) = block(width: 100%, fill: rgb("#fbe3dd"), inset: 7pt, radius: 2pt, body)
#let r2(v) = str(calc.round(v, digits: 2))
#let r1(v) = str(calc.round(v, digits: 1))
#let pc(v) = str(calc.round(v * 100)) + " %"

// ================= the house as data (from the project files) =================
#let G(n) = gf-rooms.find(r => r.name == n)
#let F(n) = ff-rooms.find(r => r.name == n)
#let Gs(prefix) = gf-rooms.find(r => r.name.starts-with(prefix))
#let Fs(prefix) = ff-rooms.find(r => r.name.starts-with(prefix))
#let gax(n) = area(G(n).P)
#let fax(n) = area(F(n).P)
#let gcl(n) = area(clear-poly(G(n), gf-walls))
#let fcl(n) = area(clear-poly(F(n), ff-walls))
#let gclp(r) = area(clear-poly(r, gf-walls))
#let fclp(r) = area(clear-poly(r, ff-walls))
#let cdims(r, spec) = { let (x0, y0, x1, y1) = bbox(clear-poly(r, spec)); (x1 - x0, y1 - y0) }
#let dw(p) = { let d = gf-doors.find(d => dist(d.a, p) < 1e-6); dist(d.a, d.b) }          // GF door width by its first point
#let fdw(p) = { let d = ff-doors.find(d => dist(d.a, p) < 1e-6); dist(d.a, d.b) }         // FF door width by its first point
#let living = Gs("Living (double")
#let dining = Gs("Living (normal")
#let majlis = G("Men's majlis")
#let wmajlis = G("Women's majlis")
#let court = G("Courtyard")
#let kitchen = G("Kitchen")
#let maid = G("Maid room")
#let maidbath = G("Maid bath")
#let laundry = G("Laundry")
#let riwaq = G("Family lobby + riwaq")
#let gallery = F("Upper gallery (on the west projection)")
#let living-clear = gclp(living) + gclp(dining)
#let court-clear = cdims(court, gf-walls)
#let sky-w = sec.x-east - sec.pj-edge                                                      // the courtyard sky between the projection edge and the kitchen wall (axes)
#let gallery-clear = sec.pj-edge - 0.125 - sec.pj-wall - 0.1                               // between the rooms' wall face and the upturned beam B3 (0.25 wide, centred on the edge)
#let gallery-clear-rail = sec.pj-edge - 0.025 - sec.pj-wall - 0.1                          // with a thin railing instead of the beam
#let riwaq-clear = cdims(riwaq, gf-walls).at(0)
#let maid-w = { let p = clear-poly(maid, gf-walls); let xs = p.map(q => q.at(0)); (calc.max(..xs) - calc.min(..xs)) }
#let maid-w-north = { let P = maid.P; let top = calc.min(..P.map(p => p.at(1))); let xs = P.filter(p => calc.abs(p.at(1) - top) < 1e-6).map(p => p.at(0)); calc.max(..xs) - calc.min(..xs) - 0.1 - 0.125 }   // the room's width at its north end, between the wall faces
#let majlis-dims = cdims(majlis, gf-walls)
#let majlis-seat = 2 * (majlis-dims.at(0) + majlis-dims.at(1)) - dw((2.75, 22.15))          // perimeter of the clear room minus the entrance opening
#let serve-route = dist((9.9, 13.0), (4.25, 13.8)) + dist((4.25, 13.8), (2.75, 16.7)) + dist((2.75, 16.7), (1.0, 17.5)) + dist((1.0, 17.5), (0.6, 21.4)) + dist((0.6, 21.4), (2.75, 23.0))   // kitchen door → living arch → serving door 1 → door 2 → guest passage → majlis opening
#let stair-flight = (2.75 - 0.125 - 0.1 - st.gap) / 2                                       // two flights side by side in the 2.75 m well on wall centre lines
// footprint, plot and envelope
#let footprint = area(outline-csv-gf) + 0.5 * 0.25 * (2 * 13.311 + 2 * 24 + 3.26 + 6.0 - 10.051 - 13.311 + 0.0)   // not used: the presentation gives 318.77; keep the outline figure below
#let outline-area = area(outline-csv-gf)
#let land-area = area(land)
#let env-area = area(env)
// the strip between the house's east face and the setback line (the lane side), site frame
#let site(p) = (p.at(0) + shift.at(0), p.at(1) + shift.at(1))
#let east-face-x = 13.311 + shift.at(0) + 0.125
#let strip-east(y-csv) = calc.min(..edges(env).map(e => seg-dist((east-face-x, y-csv + shift.at(1)), ..e)))
#let south-face-y = 24 + shift.at(1) + 0.125
#let strip-south(x-csv) = calc.min(..edges(env).map(e => seg-dist((x-csv + shift.at(0), south-face-y), ..e)))
#let drive-w = -drv.at(0).at(0)
// glazing per room: every window of the plans on the room's outline, length × (head − sill) from 3d/params.yaml (default sill / head otherwise)
#let win-h(fl, a, b) = {
  let key = (a.at(0), a.at(1), b.at(0), b.at(1))
  let m = P.openings.windows.find(w => w.floor == fl and w.at.split(" ").map(float).enumerate().all(((i, v)) => calc.abs(v - key.at(i)) < 1e-6))
  if m != none { m.head - m.sill } else { P.openings.window.head - P.openings.window.sill }
}
#let room-glass(r, fl, wins) = wins.filter(((a, b)) => {
  let m = ((a.at(0) + b.at(0)) / 2, (a.at(1) + b.at(1)) / 2)
  edges(r.P).any(e => seg-dist(m, ..e) < 0.02)
}).map(((a, b)) => dist(a, b) * win-h(fl, a, b)).sum(default: 0)
#let gf-sky = ((4.25, 9.1), (4.25, 10.5))     // the courtyard glass door counts as glazing for the riwaq
#let glass-rows = (
  ..gf-rooms.filter(r => r.id != "" and r.kind != "court" and r.kind != "tower").map(r => (fl: "GF", r: r, g: room-glass(r, "GF", gf-windows + (gf-sky,)), a: gclp(r))),
  ..ff-rooms.filter(r => r.id != "" and r.kind != "open").map(r => (fl: "FF", r: r, g: room-glass(r, "FF", ff-windows), a: fclp(r))),
)
#let glass-of(n) = glass-rows.find(x => x.r.name == n)

// ================= findings =================
// sev: critical | major | minor | suggestion · pri: the order in the top-10 list (0 = not listed)
#let findings = (
  // 1 · site
  (id: "S-01", sev: "major", pri: 0, where: [Site · parking], req: "R-11", what: [No parking is designed. The owner wants two shaded spaces by the family entrance; the municipal rule asks two spaces inside the plot for a villa over 400 m².], evidence: [No parking element in `base.typ`, `design_gf.typ` or the presentation; the only vehicle space is the driveway strip #r2(drive-w) m wide along the M line (`base.typ` drv).], rule: [Owner R-11; MOMAH villa requirements as amended July 2024 (two spaces above 400 m², the front setback usable as parking) · reported, not read in the regulation text.], fix: [Draw two covered bays. The #r2(drive-w) m strip takes bays only in line, not side by side: put them at the north end of the driveway beside the family door, or in the north setback strip if the municipality allows parking there. Effect: the family door's approach, the guest drop-off (S-02).]),
  (id: "S-02", sev: "major", pri: 0, where: [Site · guest approach], req: "R-15", what: [Guests and family share one approach. The guest door opens straight onto the driveway strip that the family's cars use; a guest arriving sees the family's cars, and the family's arrival is in view of the guest door.], evidence: [Guest entrance at CSV (0, 21.5–22.9) in the west wall, #r2(dw((0, 21.5))) m double door; family entrance at (3.0–4.0, 0) in the north wall; both reached from the driveway on the west (`base.typ` drv, `presentation.typ` gf-doors).], rule: [Owner R-15 (a guest never sees a family area); Saudi villa practice: separate guest and family approaches where the plot allows.], fix: [Split the driveway with a low wall or planting: guest drop-off and the majlis door at the south half, family parking and the family door at the north half; a gate or screen between them. Effect: S-01 parking position; the entrance canopy (S-07).]),
  (id: "S-03", sev: "critical", pri: 3, where: [Site · north and lane setbacks], req: "", what: [The house stands #r2(env-gap) m from the setback line on the north / lane side. Any survey difference of a few centimetres puts the outer wall face in the setback, which the municipality does not allow.], evidence: [`design_gf.typ` env-gap = #r2(env-gap) m, computed from the outline against the envelope of `base.typ`; `OPEN_ITEMS.md` item 1 ("confirm by the official survey").], rule: [MOMAH villa requirements: no building in the statutory setback (reported July 2024); the exact Taif setback dimensions are in the envelope, not verified against the municipal file.], fix: [Do not detail before the official survey confirms the envelope; keep a working margin of ≥ 0.20 m by moving the house south or trimming the maid wing. Effect: the maid wing's width (G-06) could absorb a move; the south garden has #r1(strip-south(6.6)) m to give.]),
  (id: "S-04", sev: "major", pri: 5, where: [Site · garden access], req: "R-30 R-19", what: [The family cannot reach the garden from the living. The only doors to the outside are the family entrance (north street), the guest door (west, driveway) and the kitchen service door (east yard). The living / dining, the most used room, has no door to the garden, and the whole south facade is the men's majlis.], evidence: [`presentation.typ` gf-doors: three doors on the outline only; the dining's east wall has a window (13.311, 14.5–17.5) and no door; the south strip of the plot is #r1(strip-south(6.6)) m deep at the middle of the south facade.], rule: [Owner R-30 (garden important), R-19 (family seating under a pergola near the palms), R-23; best practice: a family room opens to its garden.], fix: [Make the dining's east window a glazed garden door onto a walled family terrace on the east, continuing to the outdoor kitchen at the south-east corner; the terrace wall also screens the service yard (S-05). Effect: the dining furniture, the east facade, the east strip (#r1(strip-east(16)) m wide at the dining).]),
  (id: "S-05", sev: "major", pri: 0, where: [Site · east strip, service yard], req: "R-19 R-20", what: [The service yard and the family's path to the outdoor kitchen are the same strip. Bins and the gas cabinet sit at the service door at the north end of the east wall; the outdoor kitchen is at the south-east corner; the only route between them is the east strip, which is only #r1(strip-east(7.0)) m wide at the service door and on the lane side (public view).], evidence: [Service door at (13.311, 6.7–7.6) (`presentation.typ`); the lane setback line (`base.typ` env) is #r1(strip-east(7.0)) m from the east face at the service door, #r1(strip-east(12.0)) m at the kitchen window, #r1(strip-east(22.0)) m at the majlis; `DETAILS.md` puts the gas cabinet and the bins outside the service door.], rule: [Owner R-19, R-20; practice: bins and gas screened and not on a family path; gas cylinders outside with ventilation (SBC 501 / civil defence rules, not verified).], fix: [Service yard as a screened box at the north end of the east strip (bins, gas cabinet, the east manhole, the generator) with its own gate to the lane if allowed; the family reaches the outdoor kitchen through the new garden door (S-04) or a path on the south side. Effect: S-04; the east stack and manhole positions (E-03).]),
  (id: "S-06", sev: "minor", pri: 0, where: [Site · privacy from the street and the lane], req: "R-15", what: [Three windows at normal sill height face public ground: the women's majlis north window on the north street, bedroom 1's two windows on the lane, the suite bedroom's east window on the lane side.], evidence: [`presentation.typ` gf-windows (5.4–7.8, 0) sill +0.90; `ff_family.typ` windows (10.92, 1.6)–(11.79, 3.2) and (12.3, 4.15)–(12.9, 5.25) sill +0.90; `ff_suite.typ` (13.311, 15.0–18.6) sill +0.90 (`3d/params.yaml`).], rule: [Saudi practice and the Taif style: inward-looking houses, screened street windows.], fix: [Sills at 1.5 m or obscured lower panes on the street side; mashrabiya screens (the character study proposes them); keep the north window of the women's majlis small. Effect: daylight in bedroom 1 and the suite stays ample (table 3.3).]),
